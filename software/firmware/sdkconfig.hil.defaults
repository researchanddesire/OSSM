# Staging must sustain its normal MQTT connection and the read-only HTTPS probe.
# Release idle TLS record buffers, retaining the standard fragment limits,
# authentication settings and CA/config data needed by subsequent handshakes.
CONFIG_MBEDTLS_SSL_PROTO_DTLS=n
CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=n
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=n
