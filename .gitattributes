* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.FCStd binary

# Preserve the native PCB source bytes.
*.dip binary
*.dch binary
hardware/pcb/remote/*.brd -text -whitespace
hardware/pcb/remote/*.sch -text -whitespace
